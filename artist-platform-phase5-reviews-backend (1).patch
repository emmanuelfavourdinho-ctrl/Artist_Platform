index 0000000..352639e
--- /dev/null
+++ b/apps/api/src/__tests__/reviews.test.ts
@@ -0,0 +1,116 @@
+import request from 'supertest';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+/*
+  Explainer: `vi.mock` swaps out the real database connection with a
+  fake, controllable stand-in for this test file only. This is exactly
+  the sandbox limitation we talked about — without a real database
+  connection available here, this lets us still fully verify the
+  business LOGIC (validation, what gets queried, what gets blocked)
+  without needing Postgres running. On your machine, with a real
+  database, you'd additionally want to run this against the live DB —
+  these tests complement that, they don't replace it.
+*/
+vi.mock('../lib/prisma.js', () => ({
+  prisma: {
+    review: {
+      create: vi.fn(),
+      findMany: vi.fn(),
+      count: vi.fn(),
+    },
+  },
+}));
+
+import { app } from '../app.js';
+import { prisma } from '../lib/prisma.js';
+
+describe('POST /api/v1/artists/:artistId/reviews', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('rejects a rating outside the 1-5 range', async () => {
+    const response = await request(app)
+      .post('/api/v1/artists/artist-01/reviews')
+      .send({
+        authorName: 'Jane Doe',
+        authorEmail: 'jane@example.com',
+        rating: 9,
+        comment: 'This is a perfectly reasonable length comment.',
+      });
+
+    expect(response.status).toBe(400);
+    expect(prisma.review.create).not.toHaveBeenCalled();
+  });
+
+  it('rejects an invalid email address', async () => {
+    const response = await request(app)
+      .post('/api/v1/artists/artist-01/reviews')
+      .send({
+        authorName: 'Jane Doe',
+        authorEmail: 'not-an-email',
+        rating: 5,
+        comment: 'This is a perfectly reasonable length comment.',
+      });
+
+    expect(response.status).toBe(400);
+  });
+
+  it('rejects a comment that is too short (guards against low-effort spam)', async () => {
+    const response = await request(app)
+      .post('/api/v1/artists/artist-01/reviews')
+      .send({
+        authorName: 'Jane Doe',
+        authorEmail: 'jane@example.com',
+        rating: 5,
+        comment: 'short',
+      });
+
+    expect(response.status).toBe(400);
+  });
+
+  it('creates a review that always starts PENDING, even if the client tries to sneak in a different status', async () => {
+    vi.mocked(prisma.review.create).mockResolvedValue({
+      id: 'review-1',
+      status: 'PENDING',
+    } as never);
+
+    const response = await request(app)
+      .post('/api/v1/artists/artist-01/reviews')
+      .send({
+        authorName: 'Jane Doe',
+        authorEmail: 'jane@example.com',
+        rating: 5,
+        status: 'APPROVED', // deliberately trying to sneak this in
+        comment: 'This is a perfectly reasonable length comment.',
+      });
+
+    expect(response.status).toBe(201);
+    expect(response.body.data.status).toBe('PENDING');
+
+    // The real proof: check exactly what was sent to the database, and
+    // confirm the attacker-supplied "status" field never made it there
+    // at all — it was stripped out by validateBody before this
+    // controller even ran.
+    const createArgs = vi.mocked(prisma.review.create).mock.calls[0][0];
+    expect(createArgs.data).not.toHaveProperty('status');
+  });
+});
+
+describe('GET /api/v1/artists/:artistId/reviews', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('only ever queries for APPROVED reviews for that specific artist', async () => {
+    vi.mocked(prisma.review.findMany).mockResolvedValue([]);
+    vi.mocked(prisma.review.count).mockResolvedValue(0);
+
+    await request(app).get('/api/v1/artists/artist-01/reviews');
+
+    const queryArgs = vi.mocked(prisma.review.findMany).mock.calls[0][0];
+    expect(queryArgs?.where).toEqual(
+      expect.objectContaining({ artistId: 'artist-01', status: 'APPROVED' }),
+    );
+  });
+});
