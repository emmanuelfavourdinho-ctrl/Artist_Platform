diff --git a/apps/api/prisma/schema.prisma b/apps/api/prisma/schema.prisma
index 8cabf44..b19ab48 100644
--- a/apps/api/prisma/schema.prisma
+++ b/apps/api/prisma/schema.prisma
@@ -13,3 +13,67 @@ model User {
   name      String?
   createdAt DateTime @default(now())
 }
+
+/*
+  Explainer: an "enum" is just a fixed, named list of the only values
+  allowed in a field — like a multiple-choice question where these are
+  the only three valid answers. A review's `status` can ONLY ever be one
+  of these three words, never a typo like "aproved" or a made-up value.
+  This is what makes the approval workflow actually enforceable at the
+  database level, not just something we "remember" to check in code.
+*/
+enum ReviewStatus {
+  PENDING
+  APPROVED
+  REJECTED
+}
+
+/*
+  Explainer: this is the actual "review" record — one row per review
+  ever submitted, whether it ends up approved, rejected, or still
+  waiting. Every review starts life as PENDING (see the @default below)
+  the instant it's created — there is no code path that lets a brand-new
+  review skip straight to APPROVED. An admin has to actively change it.
+
+  `artistId` is a plain string for now (matching ids like "artist-01"
+  from the frontend's data files) rather than a strict foreign key,
+  because Artist records don't live in this database yet — they're
+  still in the frontend's static data files. Once artists genuinely
+  live in Postgres too (a natural future migration), this becomes a
+  real foreign key with referential integrity. Flagging that honestly
+  rather than pretending it's already fully wired up.
+*/
+model Review {
+  id          String       @id @default(cuid())
+  artistId    String
+  authorName  String
+  authorEmail String
+  rating      Int
+  comment     String
+  status      ReviewStatus @default(PENDING)
+  createdAt   DateTime     @default(now())
+  moderatedAt DateTime?
+  moderatedBy String?
+
+  // An index speeds up exactly the lookup our public endpoint does most
+  // often: "give me all APPROVED reviews for artist X" — without this,
+  // that query gets slower as the reviews table grows into the
+  // thousands; with it, it stays fast regardless of table size.
+  @@index([artistId, status])
+}
+
+/*
+  Explainer: a separate table for admins, deliberately NOT the same as
+  the regular `User` model above. There is intentionally no public
+  "sign up as admin" page anywhere — admin accounts only ever get
+  created by a trusted person running a one-off script directly against
+  the database (see scripts/createAdmin.ts). That's a deliberate
+  security choice: the smaller and more controlled the path to becoming
+  an admin, the smaller the attack surface.
+*/
+model Admin {
+  id           String   @id @default(cuid())
+  email        String   @unique
+  passwordHash String
+  createdAt    DateTime @default(now())
+}
diff --git a/apps/api/scripts/createAdmin.ts b/apps/api/scripts/createAdmin.ts
new file mode 100644
index 0000000..6a1f490
--- /dev/null
+++ b/apps/api/scripts/createAdmin.ts
@@ -0,0 +1,53 @@
+import { hashPassword } from '../src/lib/auth.js';
+import { prisma } from '../src/lib/prisma.js';
+
+/*
+  Explainer: this is a one-off script — you run it manually, from your
+  own terminal, when you personally decide a new admin account should
+  exist. It is NOT a route the website exposes to visitors, and there is
+  deliberately no "sign up as admin" button anywhere on the site. That's
+  the whole security model for how someone becomes an admin: only
+  someone with direct access to this codebase and this database can
+  create one, ever.
+
+  Usage:  npm run create-admin -- you@example.com "a genuinely strong password"
+  (everything after the -- gets passed through as arguments to this script)
+*/
+async function main() {
+  const email = process.argv[2];
+  const password = process.argv[3];
+
+  if (!email || !password) {
+    console.error('Usage: npm run create-admin -- <email> <password>');
+    process.exitCode = 1;
+    return;
+  }
+
+  if (password.length < 12) {
+    console.error('Password must be at least 12 characters long.');
+    process.exitCode = 1;
+    return;
+  }
+
+  const passwordHash = await hashPassword(password);
+
+  // `upsert` = "update if it already exists, otherwise create it" — so
+  // running this script again for the same email safely resets that
+  // admin's password instead of erroring out.
+  const admin = await prisma.admin.upsert({
+    where: { email },
+    update: { passwordHash },
+    create: { email, passwordHash },
+  });
+
+  console.log(`Admin account ready: ${admin.email}`);
+}
+
+main()
+  .catch((err) => {
+    console.error(err);
+    process.exitCode = 1;
+  })
+  .finally(async () => {
+    await prisma.$disconnect();
+  });
