@@ -0,0 +1,32 @@
+import { Router } from 'express';
+
+import {
+  adminLogin,
+  adminLogout,
+  listPendingReviews,
+  moderateReview,
+} from '../controllers/adminController.js';
+import { asyncHandler } from '../lib/asyncHandler.js';
+import { requireAdmin } from '../middleware/requireAdmin.js';
+import { validateBody } from '../middleware/validate.js';
+import { adminLoginSchema, moderateReviewSchema } from '../validation/review.js';
+
+export const adminRouter = Router();
+
+// Login and logout are deliberately NOT behind requireAdmin — you can't
+// be required to already be logged in just to log in.
+adminRouter.post('/login', validateBody(adminLoginSchema), asyncHandler(adminLogin));
+adminRouter.post('/logout', asyncHandler(adminLogout));
+
+// Every route below this line runs requireAdmin FIRST. Because
+// router.use() applies to every route defined after it in this file,
+// we don't have to repeat `requireAdmin` on each individual line — one
+// declaration protects everything underneath it.
+adminRouter.use(requireAdmin);
+
+adminRouter.get('/reviews', asyncHandler(listPendingReviews));
+adminRouter.patch(
+  '/reviews/:id',
+  validateBody(moderateReviewSchema),
+  asyncHandler(moderateReview),
+);
