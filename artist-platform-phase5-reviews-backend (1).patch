@@ -0,0 +1,144 @@
+import request from 'supertest';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('../lib/prisma.js', () => ({
+  prisma: {
+    review: {
+      findMany: vi.fn(),
+      findUnique: vi.fn(),
+      update: vi.fn(),
+    },
+    admin: {
+      findUnique: vi.fn(),
+    },
+  },
+}));
+
+import { app } from '../app.js';
+import { hashPassword } from '../lib/auth.js';
+import { prisma } from '../lib/prisma.js';
+
+const REAL_PASSWORD = 'a-genuinely-strong-password-123';
+
+async function mockAdminAccount() {
+  vi.mocked(prisma.admin.findUnique).mockResolvedValue({
+    id: 'admin-1',
+    email: 'admin@example.com',
+    passwordHash: await hashPassword(REAL_PASSWORD),
+    createdAt: new Date(),
+  } as never);
+}
+
+describe('Admin authentication', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('blocks the moderation queue for anyone not logged in', async () => {
+    const response = await request(app).get('/api/v1/admin/reviews');
+    expect(response.status).toBe(401);
+  });
+
+  it('blocks moderation actions for anyone not logged in', async () => {
+    const response = await request(app)
+      .patch('/api/v1/admin/reviews/review-1')
+      .send({ action: 'approve' });
+    expect(response.status).toBe(401);
+  });
+
+  it('rejects a login with the wrong password', async () => {
+    await mockAdminAccount();
+
+    const response = await request(app)
+      .post('/api/v1/admin/login')
+      .send({ email: 'admin@example.com', password: 'totally-the-wrong-password' });
+
+    expect(response.status).toBe(401);
+  });
+
+  it('rejects a login for an email that has no admin account, with the SAME error as a wrong password', async () => {
+    vi.mocked(prisma.admin.findUnique).mockResolvedValue(null);
+
+    const response = await request(app)
+      .post('/api/v1/admin/login')
+      .send({ email: 'nobody@example.com', password: 'anything-at-all' });
+
+    expect(response.status).toBe(401);
+    expect(response.body.message).toBe('Invalid email or password');
+  });
+
+  it('logs in with correct credentials and can then reach the moderation queue', async () => {
+    await mockAdminAccount();
+
+    // request.agent (unlike plain `request`) remembers cookies between
+    // requests within this test, the same way a real browser tab does —
+    // this is what lets us prove the login cookie itself is what grants
+    // access, not just that /login returns 200.
+    const agent = request.agent(app);
+
+    const login = await agent
+      .post('/api/v1/admin/login')
+      .send({ email: 'admin@example.com', password: REAL_PASSWORD });
+    expect(login.status).toBe(200);
+
+    vi.mocked(prisma.review.findMany).mockResolvedValue([]);
+    const queue = await agent.get('/api/v1/admin/reviews');
+    expect(queue.status).toBe(200);
+  });
+});
+
+describe('PATCH /api/v1/admin/reviews/:id (approve/reject)', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  async function loggedInAgent() {
+    await mockAdminAccount();
+    const agent = request.agent(app);
+    await agent.post('/api/v1/admin/login').send({ email: 'admin@example.com', password: REAL_PASSWORD });
+    return agent;
+  }
+
+  it('rejects an unknown action value instead of silently ignoring it', async () => {
+    const agent = await loggedInAgent();
+
+    const response = await agent
+      .patch('/api/v1/admin/reviews/review-1')
+      .send({ action: 'delete-everything' }); // not a real action
+
+    expect(response.status).toBe(400);
+    expect(prisma.review.update).not.toHaveBeenCalled();
+  });
+
+  it('returns 404 for a review id that does not exist', async () => {
+    const agent = await loggedInAgent();
+    vi.mocked(prisma.review.findUnique).mockResolvedValue(null);
+
+    const response = await agent
+      .patch('/api/v1/admin/reviews/does-not-exist')
+      .send({ action: 'approve' });
+
+    expect(response.status).toBe(404);
+  });
+
+  it('approving a review flips its status and records exactly which admin approved it', async () => {
+    const agent = await loggedInAgent();
+    vi.mocked(prisma.review.findUnique).mockResolvedValue({ id: 'review-1' } as never);
+    vi.mocked(prisma.review.update).mockResolvedValue({
+      id: 'review-1',
+      status: 'APPROVED',
+      moderatedBy: 'admin@example.com',
+    } as never);
+
+    const response = await agent
+      .patch('/api/v1/admin/reviews/review-1')
+      .send({ action: 'approve' });
+
+    expect(response.status).toBe(200);
+    expect(response.body.data.status).toBe('APPROVED');
+
+    const updateArgs = vi.mocked(prisma.review.update).mock.calls[0][0];
+    expect(updateArgs.data.status).toBe('APPROVED');
+    expect(updateArgs.data.moderatedBy).toBe('admin@example.com');
+  });
+});
