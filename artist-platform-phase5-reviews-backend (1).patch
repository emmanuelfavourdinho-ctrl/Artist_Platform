 });
 
 const env = envSchema.parse(process.env);
 
 export const config = {
+  nodeEnv: env.NODE_ENV,
+  isProduction: env.NODE_ENV === 'production',
   port: Number(env.PORT),
   databaseUrl: env.DATABASE_URL,
   redisUrl: env.REDIS_URL,
   apiUrl: env.API_URL,
   corsOrigin: env.CORS_ORIGIN ?? 'http://localhost:3000',
+  jwtSecret: env.JWT_SECRET,
 };
diff --git a/apps/api/src/controllers/adminController.ts b/apps/api/src/controllers/adminController.ts
new file mode 100644
index 0000000..6617ebf
--- /dev/null
+++ b/apps/api/src/controllers/adminController.ts
@@ -0,0 +1,94 @@
+import type { Request, Response } from 'express';
+
+import { config } from '../config/index.js';
+import { signAdminToken, verifyPassword } from '../lib/auth.js';
+import { HttpError } from '../lib/httpError.js';
+import { prisma } from '../lib/prisma.js';
+import type { AdminLoginInput, ModerateReviewInput } from '../validation/review.js';
+
+// Shared cookie settings, used by both login (to set the cookie) and
+// logout (to clear it) — keeping them in one place means login and
+// logout can never accidentally disagree about the cookie's settings.
+const ADMIN_COOKIE_NAME = 'admin_token';
+const adminCookieOptions = {
+  httpOnly: true, // invisible to JavaScript — see requireAdmin.ts for why this matters
+  secure: config.isProduction, // only sent over HTTPS once deployed for real; localhost dev uses plain HTTP
+  sameSite: 'lax' as const, // blocks the cookie being sent along with cross-site requests, a defense against CSRF
+  maxAge: 8 * 60 * 60 * 1000, // 8 hours, matching the token's own expiry in lib/auth.ts
+};
+
+/*
+  Explainer: POST /api/v1/admin/login. On success, we don't send the
+  token back as JSON for the frontend to store itself (e.g. in
+  localStorage) — storing tokens in localStorage is readable by any
+  JavaScript on the page, including injected malicious scripts. Instead
+  we set it directly as an httpOnly cookie ourselves, which the browser
+  then automatically attaches to every future request to our API,
+  without any frontend code ever touching the token's actual value.
+*/
+export async function adminLogin(req: Request, res: Response) {
+  const { email, password } = req.body as AdminLoginInput;
+
+  const admin = await prisma.admin.findUnique({ where: { email } });
+
+  // Deliberately identical error whether the email doesn't exist OR the
+  // password is wrong. Telling an attacker "that email isn't registered"
+  // vs "wrong password" leaks which emails are valid admin accounts —
+  // a real information leak, even though it seems like a small detail.
+  if (!admin || !(await verifyPassword(password, admin.passwordHash))) {
+    throw new HttpError(401, 'Invalid email or password');
+  }
+
+  const token = signAdminToken({ adminId: admin.id, email: admin.email });
+  res.cookie(ADMIN_COOKIE_NAME, token, adminCookieOptions);
+
+  res.json({ status: 'success', message: 'Logged in' });
+}
+
+export async function adminLogout(_req: Request, res: Response) {
+  res.clearCookie(ADMIN_COOKIE_NAME, adminCookieOptions);
+  res.json({ status: 'success', message: 'Logged out' });
+}
+
+/*
+  Explainer: GET /api/v1/admin/reviews — the moderation queue. This
+  route is only reachable at all if the requireAdmin middleware already
+  let the request through, so by the time this function runs, we already
+  know it's a genuine logged-in admin asking.
+*/
+export async function listPendingReviews(_req: Request, res: Response) {
+  const reviews = await prisma.review.findMany({
+    where: { status: 'PENDING' },
+    orderBy: { createdAt: 'asc' }, // oldest-first — first come, first reviewed
+  });
+
+  res.json({ status: 'success', data: reviews });
+}
+
+/*
+  Explainer: PATCH /api/v1/admin/reviews/:id — an admin clicking
+  approve or reject on one specific review. `req.admin.email` here comes
+  from the requireAdmin middleware, which decoded it from that admin's
+  own token — so `moderatedBy` always accurately records exactly which
+  admin made the call, useful if this ever needs auditing later.
+*/
+export async function moderateReview(req: Request, res: Response) {
+  const { id } = req.params;
+  const { action } = req.body as ModerateReviewInput;
+
+  const existing = await prisma.review.findUnique({ where: { id } });
+  if (!existing) {
+    throw new HttpError(404, 'Review not found');
+  }
+
+  const review = await prisma.review.update({
+    where: { id },
+    data: {
+      status: action === 'approve' ? 'APPROVED' : 'REJECTED',
+      moderatedAt: new Date(),
+      moderatedBy: req.admin?.email,
+    },
+  });
+
+  res.json({ status: 'success', data: review });
+}
diff --git a/apps/api/src/controllers/reviewController.ts b/apps/api/src/controllers/reviewController.ts
new file mode 100644
index 0000000..7d5c627
--- /dev/null
+++ b/apps/api/src/controllers/reviewController.ts
@@ -0,0 +1,88 @@
+import type { Request, Response } from 'express';
+
+import { prisma } from '../lib/prisma.js';
+import type { SubmitReviewInput } from '../validation/review.js';
+
+/*
+  Explainer: this handles POST /api/v1/artists/:artistId/reviews — a
+  customer submitting a new review. By the time this function runs, the
+  validateBody middleware has ALREADY confirmed req.body matches
+  submitReviewSchema exactly, so we can trust every field here without
+  re-checking it.
+
+  Notice there is no `status` field being set from the request — status
+  always starts as PENDING, decided by the database schema's default,
+  never by anything the visitor sends. That's deliberate: nothing in
+  this function even gives a submitter the ABILITY to mark their own
+  review as approved, even by accident or by tampering with the request.
+*/
+export async function submitReview(req: Request, res: Response) {
+  const { artistId } = req.params;
+  const input = req.body as SubmitReviewInput;
+
+  const review = await prisma.review.create({
+    data: {
+      artistId,
+      authorName: input.authorName,
+      authorEmail: input.authorEmail,
+      rating: input.rating,
+      comment: input.comment,
+    },
+  });
+
+  res.status(201).json({
+    status: 'success',
+    message: 'Thanks! Your review will appear once it has been approved.',
+    data: {
+      id: review.id,
+      status: review.status,
+    },
+  });
+}
+
+/*
+  Explainer: this handles GET /api/v1/artists/:artistId/reviews — what
+  the public artist profile page will eventually call. The
+  `status: 'APPROVED'` line below is the entire enforcement of "only
+  approved reviews are public" — it's a hard filter baked directly into
+  the database query itself, not a check we remember to add in the
+  frontend. Even a bug elsewhere in the app couldn't accidentally leak a
+  pending or rejected review through this endpoint.
+*/
+export async function listApprovedReviews(req: Request, res: Response) {
+  const { artistId } = req.params;
+
+  // Basic pagination — without this, an artist with thousands of
+  // reviews would force every visitor to download all of them at once.
+  // ?page=2&pageSize=10 lets the frontend request one page at a time.
+  const page = Math.max(1, Number(req.query.page) || 1);
+  const pageSize = Math.min(50, Math.max(1, Number(req.query.pageSize) || 10));
+
+  const [reviews, total] = await Promise.all([
+    prisma.review.findMany({
+      where: { artistId, status: 'APPROVED' },
+      orderBy: { createdAt: 'desc' },
+      skip: (page - 1) * pageSize,
+      take: pageSize,
+      select: {
+        id: true,
+        authorName: true,
+        rating: true,
+        comment: true,
+        createdAt: true,
+      },
+    }),
+    prisma.review.count({ where: { artistId, status: 'APPROVED' } }),
+  ]);
+
+  res.json({
+    status: 'success',
+    data: reviews,
+    pagination: {
+      page,
+      pageSize,
+      total,
+      totalPages: Math.ceil(total / pageSize),
+    },
+  });
+}
diff --git a/apps/api/src/lib/asyncHandler.ts b/apps/api/src/lib/asyncHandler.ts
new file mode 100644
index 0000000..f0c6ed4
--- /dev/null
+++ b/apps/api/src/lib/asyncHandler.ts
@@ -0,0 +1,22 @@
+import type { NextFunction, Request, Response } from 'express';
+
+/*
+  Explainer: Express was originally built before `async/await` existed
+  in JavaScript, so it has a gap — if an `async` function throws (or a
+  Promise it's awaiting rejects), Express does NOT automatically catch
+  that and hand it to our errorHandler middleware. Without this wrapper,
+  an error thrown inside, say, submitReview would just vanish into an
+  "unhandled promise rejection" instead of turning into a proper error
+  response for the visitor.
+
+  This function solves it once, in one place: wrap any async controller
+  with asyncHandler(...), and any error it throws gets correctly forwarded
+  to next(err) — which is exactly what routes to our errorHandler.
+*/
+type AsyncRouteHandler = (req: Request, res: Response, next: NextFunction) => Promise<void>;
+
+export function asyncHandler(handler: AsyncRouteHandler) {
+  return (req: Request, res: Response, next: NextFunction) => {
+    handler(req, res, next).catch(next);
+  };
+}
diff --git a/apps/api/src/lib/auth.ts b/apps/api/src/lib/auth.ts
new file mode 100644
index 0000000..4a13cf2
--- /dev/null
+++ b/apps/api/src/lib/auth.ts
@@ -0,0 +1,64 @@
+import bcrypt from 'bcryptjs';
+import jwt from 'jsonwebtoken';
+
+import { config } from '../config/index.js';
+
+/*
+  Explainer: this file holds every function related to "proving someone
+  really is who they say they are" — hashing/checking passwords, and
+  issuing/verifying the token that says "this request is genuinely from
+  a logged-in admin". Keeping all of it in one small file means there's
+  exactly one place in the whole codebase that touches passwords or
+  tokens directly — easier to review, easier to audit, easier to trust.
+*/
+
+// How much computational "work" bcrypt does per password — higher is
+// slower (and therefore safer against brute-force guessing) but also
+// slower for real logins. 12 is a well-established, industry-standard
+// middle ground as of today.
+const BCRYPT_SALT_ROUNDS = 12;
+
+/*
+  Explainer: we NEVER store a password as plain text — if our database
+  ever leaked, plain-text passwords would hand attackers everyone's
+  actual password immediately. Hashing turns a password into a
+  one-way scrambled version: easy to check "does this match?", but
+  computationally infeasible to reverse back into the original password.
+*/
+export async function hashPassword(plainPassword: string): Promise<string> {
+  return bcrypt.hash(plainPassword, BCRYPT_SALT_ROUNDS);
+}
+
+export async function verifyPassword(plainPassword: string, passwordHash: string): Promise<boolean> {
+  return bcrypt.compare(plainPassword, passwordHash);
+}
+
+export type AdminTokenPayload = {
+  adminId: string;
+  email: string;
+};
+
+/*
+  Explainer: a JWT (JSON Web Token) is a signed, tamper-proof piece of
+  text — think of it like a wristband at a concert. It has information
+  printed on it (which admin this is), and it's signed with our secret
+  key so that anyone trying to forge or edit one produces an invalid
+  signature that our server immediately rejects. The token expires after
+  8 hours, so even a stolen one becomes useless before too long.
+*/
+export function signAdminToken(payload: AdminTokenPayload): string {
+  return jwt.sign(payload, config.jwtSecret, { expiresIn: '8h' });
+}
+
+export function verifyAdminToken(token: string): AdminTokenPayload | null {
+  try {
+    return jwt.verify(token, config.jwtSecret) as AdminTokenPayload;
+  } catch {
+    // Any failure here (expired, tampered with, signed with a different
+    // secret, malformed) is treated identically: "not a valid admin
+    // session." We deliberately don't distinguish the reasons to the
+    // caller — that information isn't useful to a legitimate user and
+    // is exactly the kind of detail that helps an attacker.
+    return null;
+  }
+}
diff --git a/apps/api/src/lib/httpError.ts b/apps/api/src/lib/httpError.ts
new file mode 100644
index 0000000..27973ab
--- /dev/null
+++ b/apps/api/src/lib/httpError.ts
@@ -0,0 +1,17 @@
+/*
+  Explainer: a normal JavaScript Error doesn't have a concept of
+  "HTTP status code" — this small class adds one. Throwing
+  `new HttpError(404, 'Review not found')` anywhere in a controller lets
+  the existing errorHandler middleware (in middleware/errorHandler.ts)
+  automatically turn it into the correct HTTP response, without every
+  controller needing to know how to format a response itself.
+*/
+export class HttpError extends Error {
+  status: number;
+
+  constructor(status: number, message: string) {
+    super(message);
+    this.status = status;
+    this.name = 'HttpError';
+  }
+}
