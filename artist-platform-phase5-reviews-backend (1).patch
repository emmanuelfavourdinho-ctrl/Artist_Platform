+  to the database ("give me all approved reviews for artist-01", etc).
+  Creating one of these objects opens a small pool of real connections
+  to Postgres — so we want exactly ONE of them shared across the whole
+  app, not a new one created every time a file needs it. This file is
+  that single shared instance; every controller imports `prisma` from
+  here rather than creating its own.
+*/
+export const prisma = new PrismaClient();
diff --git a/apps/api/src/middleware/requireAdmin.ts b/apps/api/src/middleware/requireAdmin.ts
new file mode 100644
index 0000000..9f50ec5
--- /dev/null
+++ b/apps/api/src/middleware/requireAdmin.ts
@@ -0,0 +1,52 @@
+import type { NextFunction, Request, Response } from 'express';
+
+import { verifyAdminToken } from '../lib/auth.js';
+import { HttpError } from '../lib/httpError.js';
+
+// Extends Express's built-in Request type so TypeScript knows about the
+// `admin` property this middleware attaches — without this, code later
+// in the chain (like the moderation controller) couldn't safely read
+// `req.admin` without a type error.
+declare global {
+  // eslint-disable-next-line @typescript-eslint/no-namespace
+  namespace Express {
+    interface Request {
+      admin?: { adminId: string; email: string };
+    }
+  }
+}
+
+/*
+  Explainer: this is the security gate for every admin-only endpoint.
+  It runs BEFORE the actual controller (like "approve this review") and
+  answers one question: does this request have a valid, un-expired,
+  correctly-signed admin token? If yes, it attaches who the admin is to
+  `req.admin` and lets the request continue. If no — for any reason at
+  all — it stops the request immediately with a 401 and the controller
+  code never even runs.
+
+  The token itself comes from an httpOnly cookie (set during login),
+  rather than being readable by JavaScript in the browser at all — that
+  specifically protects against XSS attacks: even if a malicious script
+  somehow ran on the admin's page, it could not read this cookie to
+  steal the token, because httpOnly cookies are invisible to JavaScript
+  entirely, by browser design.
+*/
+export function requireAdmin(req: Request, _res: Response, next: NextFunction) {
+  const token = req.cookies?.admin_token as string | undefined;
+
+  if (!token) {
+    next(new HttpError(401, 'Admin login required'));
+    return;
+  }
+
+  const payload = verifyAdminToken(token);
+
+  if (!payload) {
+    next(new HttpError(401, 'Admin session is invalid or has expired'));
+    return;
+  }
+
+  req.admin = payload;
+  next();
+}
diff --git a/apps/api/src/middleware/reviewRateLimiter.ts b/apps/api/src/middleware/reviewRateLimiter.ts
new file mode 100644
index 0000000..e5b2741
--- /dev/null
+++ b/apps/api/src/middleware/reviewRateLimiter.ts
@@ -0,0 +1,28 @@
+import rateLimit from 'express-rate-limit';
+
+/*
+  Explainer: rate limiting answers the question "how many times can the
+  SAME visitor hit this specific endpoint in a short window of time?"
+  Without it, one person (or a bot) could submit hundreds of fake
+  reviews in seconds — flooding the admin's moderation queue and making
+  it impractical to review real feedback. This limits any single visitor
+  to 5 review submissions per 15 minutes; a genuine customer leaving one
+  honest review is completely unaffected, while a spam attempt hits a
+  wall almost immediately.
+
+  Note this is layered on TOP of admin approval, not instead of it —
+  even a submission that gets through rate limiting still starts as
+  PENDING and stays invisible until an admin approves it. Rate limiting
+  protects the moderation queue itself from being flooded; approval
+  protects the public page from ever showing something unapproved.
+*/
+export const reviewRateLimiter = rateLimit({
+  windowMs: 15 * 60 * 1000, // 15 minutes
+  limit: 5,
+  standardHeaders: true, // tells the caller their remaining quota via response headers
+  legacyHeaders: false,
+  message: {
+    status: 'error',
+    message: 'Too many reviews submitted recently. Please try again later.',
+  },
+});
diff --git a/apps/api/src/middleware/validate.ts b/apps/api/src/middleware/validate.ts
new file mode 100644
index 0000000..eda6595
--- /dev/null
+++ b/apps/api/src/middleware/validate.ts
@@ -0,0 +1,36 @@
+import type { NextFunction, Request, Response } from 'express';
+import type { ZodSchema } from 'zod';
+
+import { HttpError } from '../lib/httpError.js';
+
+/*
+  Explainer: this is a small "factory" — a function that builds a
+  middleware function, customized for whatever schema you hand it. This
+  pattern means we write the "check the request body against a schema,
+  and reject it clearly if it fails" logic exactly ONCE, and reuse it for
+  every endpoint that needs validation (review submission, admin login,
+  moderation actions) rather than repeating similar validation code in
+  every single controller.
+
+  Usage: router.post('/reviews', validateBody(submitReviewSchema), submitReview)
+*/
+export function validateBody<T>(schema: ZodSchema<T>) {
+  return (req: Request, _res: Response, next: NextFunction) => {
+    const result = schema.safeParse(req.body);
+
+    if (!result.success) {
+      // .issues[0] is the FIRST validation problem Zod found — showing
+      // just one clear message is friendlier than dumping a wall of
+      // every possible error at once.
+      const firstIssue = result.error.issues[0];
+      next(new HttpError(400, firstIssue?.message ?? 'Invalid request body'));
+      return;
+    }
+
+    // Replace the raw, untrusted body with the parsed, validated,
+    // correctly-typed version — everything downstream (the controller)
+    // can now trust req.body completely.
+    req.body = result.data;
+    next();
+  };
+}
