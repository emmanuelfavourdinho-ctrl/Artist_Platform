{
  "name": "@artist-platform/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{ts,js}\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.19.0",
    "helmet": "^7.0.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.18",
    "@types/helmet": "^4.0.0",
    "@types/node": "^20.14.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "prettier": "^3.0.0",
    "prisma": "^5.12.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
