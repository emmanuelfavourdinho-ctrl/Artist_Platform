generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// READ ME FIRST — design decisions a new maintainer should know before
// changing this file. Keep this section updated as decisions change; a
// schema this large is much harder to reason about without it.
// ===========================================================================
//
// 1. IDs: every model uses `id String @id @default(uuid())` — a randomly
//    generated, globally-unique identifier. Consistent across the whole
//    schema; don't introduce auto-increment ints for a new model.
//
// 2. Money: every monetary field is `Decimal @db.Decimal(12, 2)`, never
//    Float. Floats store money as an approximation ("0.1 + 0.2 != 0.3").
//    IMPORTANT for API/frontend authors: Prisma serializes Decimal to
//    JSON as a STRING, not a number — always `Number(value)` before
//    formatting or doing arithmetic in TypeScript.
//
// 3. Currency codes (USD, EUR, XAF, ...) are plain `String`, not an enum —
//    150+ real codes exist and Postgres enums need a migration to add a
//    single new value. Validate the code at the application layer instead.
//
// 4. STRING vs ENUM, the actual rule we follow: use a Postgres enum when
//    the set of values is small, fixed, and changing it SHOULD require a
//    deliberate migration (order status, verification status, review
//    status — these are core business states, and a typo here should be
//    a compile-time error, not a silent bad write). Use a plain String
//    when the set of values is expected to grow over time via normal
//    product/admin activity, not a schema change (Role.name, Category/
//    Medium/Style/Theme.name, Notification.type, Payment.provider).
//    Do NOT add a "shadow enum" next to a String field that's
//    intentionally a String (see the Role note below for a real example
//    of this mistake, already made and reverted once).
//
// 5. Composite primary keys: pure "junction" tables that only ever
//    connect two other records with nothing of their own worth looking
//    up individually (UserRole, RolePermission, ArtworkCategory,
//    ArtworkStyle, ArtworkTheme, ArtworkMedium, Favorite) use a
//    COMPOSITE PRIMARY KEY — e.g. `@@id([userId, roleId])` — instead of a
//    separate synthetic id. That composite key is already guaranteed
//    unique by definition, so it enforces "no duplicate pairs" for free.
//    CartItem is the one exception (it has its own `id`), since cart
//    line items are individually addressable (edit quantity by id, etc).
//
// 6. onDelete follows one consistent rule everywhere: anything that
//    represents FINANCIAL OR HISTORICAL TRUTH (an Order, a Payment, a
//    completed OrderItem's record of what was bought, a Review, an
//    AuditLog entry) is protected with `Restrict` or preserved via
//    `SetNull` — the database refuses to silently destroy that history
//    as a side effect of deleting something else. Anything that's just
//    "glue" with no independent meaning (a CartItem without its Cart, an
//    ArtworkImage without its Artwork) safely cascades. When adding a
//    new relation, ask "does losing this row silently lose something we
//    need to be able to prove happened later?" — if yes, Restrict/
//    SetNull; if no, Cascade is fine.
//
// 7. Indexing philosophy: Postgres does NOT automatically index foreign
//    key columns — every `fields: [xId]` relation should usually have a
//    matching `@@index([xId])` unless it's already covered by a
//    composite index. Beyond foreign keys, index columns that are
//    actually filtered/sorted on in real application queries — check the
//    controller before adding one. Where a hot query path filters or
//    sorts on MULTIPLE columns together (e.g. Artwork's public listing
//    always filters status + visibility and sorts by publishedAt), add
//    ONE composite index covering that combination — it's meaningfully
//    faster than Postgres combining several single-column indexes for
//    the same query, not just a style preference.
//
// 8. AUTH: identity lives in Firebase, not here. `firebaseUid` is the
//    stable link between a Firebase Authenticated person and their
//    PostgreSQL User row (see apps/api/src/controllers/authController.ts
//    syncUser()). `passwordHash` is optional and effectively legacy —
//    Firebase issues and verifies passwords now; nothing should write
//    to passwordHash for new users. It stays nullable rather than being
//    deleted outright so any pre-Firebase rows/code aren't broken by a
//    hard schema removal — plan a follow-up migration to drop it once
//    every user has been confirmed to have a firebaseUid.
//
// ===========================================================================

// ===========================================================================
// DOMAIN 1 — IDENTITY & ACCESS
// ===========================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

model User {
  id              String     @id @default(uuid())
  firebaseUid     String?    @unique
  email           String     @unique
  passwordHash    String?
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles                 UserRole[]
  sessions              Session[]
  addresses             Address[]
  artistProfile         ArtistProfile?
  cart                  Cart?
  orders                Order[]
  favorites             Favorite[]
  reviews               Review[]
  commissionsRequested  CommissionRequest[]    @relation("BuyerCommissions")
  notifications         Notification[]
  moderationActions     ArtworkModeration[]    @relation("AdminModerationActions")
  auditLogs             AuditLog[]
  inventoryReservations InventoryReservation[]
  conversationsAsBuyer  Conversation[]         @relation("BuyerConversations")
  messagesSent          Message[]

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  label         String?
  recipientName String
  phone         String?
  addressLine1  String
  addressLine2  String?
  city          String
  region        String?
  country       String
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===========================================================================
// DOMAIN 2 — ARTIST
// ===========================================================================

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model ArtistProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  displayName        String
  slug               String             @unique
  biography          String?
  artisticStatement  String?
  mission            String?
  website            String?
  location           String?
  profileImageUrl    String?
  coverImageUrl      String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements        ArtistAchievement[]
  socialLinks         ArtistSocialLink[]
  artworks            Artwork[]
  orderItems          OrderItem[]
  commissionsReceived CommissionRequest[] @relation("ArtistCommissions")
  conversations       Conversation[]      @relation("ArtistConversations")

  @@index([slug])
  @@index([verificationStatus])
}

model ArtistAchievement {
  id           String   @id @default(uuid())
  artistId     String
  title        String
  organization String?
  description  String?
  year         Int?
  type         String?
  createdAt    DateTime @default(now())

  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

model ArtistSocialLink {
  id        String   @id @default(uuid())
  artistId  String
  platform  String
  url       String
  createdAt DateTime @default(now())

  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, platform])
}

// ===========================================================================
// DOMAIN 3 — ARTWORK
// ===========================================================================

enum ArtworkStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
  SOLD
}

enum ArtworkVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model Artwork {
  id          String            @id @default(uuid())
  artistId    String
  title       String
  slug        String            @unique
  description String?
  artistNotes String?
  price       Decimal           @db.Decimal(12, 2)
  currency    String
  yearCreated Int?
  width       Decimal?          @db.Decimal(8, 2)
  height      Decimal?          @db.Decimal(8, 2)
  depth       Decimal?          @db.Decimal(8, 2)
  weight      Decimal?          @db.Decimal(8, 2)
  materials   String?
  status      ArtworkStatus     @default(DRAFT)
  visibility  ArtworkVisibility @default(PRIVATE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  artist                ArtistProfile          @relation(fields: [artistId], references: [id], onDelete: Restrict)
  images                ArtworkImage[]
  categories            ArtworkCategory[]
  styles                ArtworkStyle[]
  themes                ArtworkTheme[]
  mediums               ArtworkMedium[]
  inventory             Inventory?
  cartItems             CartItem[]
  orderItems            OrderItem[]
  favorites             Favorite[]
  reviews               Review[]
  moderationHistory     ArtworkModeration[]
  inventoryReservations InventoryReservation[]

  @@index([artistId])
  @@index([status])
  @@index([visibility])
  @@index([publishedAt])
  @@index([price])
  @@index([status, visibility, publishedAt])
}

model ArtworkImage {
  id           String   @id @default(uuid())
  artworkId    String
  url          String
  publicId     String?  @unique
  secureUrl    String?
  resourceType String   @default("image")
  format       String?
  bytes        Int?
  altText      String?
  width        Int?
  height       Int?
  position     Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId])
  @@index([artworkId, isPrimary])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  artworks ArtworkCategory[]
}

model Medium {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  artworks ArtworkMedium[]
}

model Style {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  artworks ArtworkStyle[]
}

model Theme {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  artworks ArtworkTheme[]
}

model ArtworkCategory {
  artworkId  String
  categoryId String
  createdAt  DateTime @default(now())

  artwork  Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([artworkId, categoryId])
  @@index([categoryId])
}

model ArtworkStyle {
  artworkId String
  styleId   String
  createdAt DateTime @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  style   Style   @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([artworkId, styleId])
  @@index([styleId])
}

model ArtworkTheme {
  artworkId String
  themeId   String
  createdAt DateTime @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([artworkId, themeId])
  @@index([themeId])
}

model ArtworkMedium {
  artworkId String
  mediumId  String
  createdAt DateTime @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  medium  Medium  @relation(fields: [mediumId], references: [id], onDelete: Cascade)

  @@id([artworkId, mediumId])
  @@index([mediumId])
}

// ===========================================================================
// DOMAIN 4 — INVENTORY
// ===========================================================================

model Inventory {
  id               String   @id @default(uuid())
  artworkId        String   @unique
  quantity         Int      @default(1)
  reservedQuantity Int      @default(0)
  soldQuantity     Int      @default(0)
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// DOMAIN 5 — CART
// ===========================================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  artworkId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([cartId, artworkId])
  @@index([cartId])
}

// ===========================================================================
// DOMAIN 6 — ORDERS
// ===========================================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  subtotal       Decimal @db.Decimal(12, 2)
  shippingAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  currency       String

  shippingAddressSnapshot Json
  billingAddressSnapshot  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  payments     Payment[]
  invoice      Invoice?
  shipment     Shipment?
  reservations InventoryReservation[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  artworkId String?
  artistId  String?

  titleSnapshot      String
  artistNameSnapshot String
  unitPrice          Decimal @db.Decimal(12, 2)
  quantity           Int
  currency           String
  subtotal           Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artwork Artwork?       @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  artist  ArtistProfile? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([orderId])
  @@index([artistId])
  @@index([artworkId])
}

// ===========================================================================
// DOMAIN 7 — PAYMENT
// ===========================================================================

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  provider          String
  providerPaymentId String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
}

// ===========================================================================
// DOMAIN 8 — INVENTORY RESERVATION
// ===========================================================================

enum ReservationStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONVERTED
}

model InventoryReservation {
  id         String            @id @default(uuid())
  artworkId  String
  userId     String
  orderId    String?
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([artworkId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// ===========================================================================
// DOMAIN 9 — INVOICE
// ===========================================================================

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  subtotal      Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  currency      String
  issuedAt      DateTime @default(now())
  pdfUrl        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

// ===========================================================================
// DOMAIN 10 — SHIPMENT
// ===========================================================================

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

model Shipment {
  id                  String         @id @default(uuid())
  orderId             String         @unique
  carrier             String?
  trackingNumber      String?
  status              ShipmentStatus @default(PENDING)
  shippedAt           DateTime?
  deliveredAt         DateTime?
  estimatedDeliveryAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status])
}

// ===========================================================================
// DOMAIN 11 — FAVORITES
// ===========================================================================

model Favorite {
  userId    String
  artworkId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@id([userId, artworkId])
  @@index([artworkId])
}

// ===========================================================================
// DOMAIN 12 — REVIEWS
// ===========================================================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id          String       @id @default(uuid())
  userId      String
  artworkId   String?
  orderItemId String?
  rating      Int
  title       String?
  comment     String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  artwork   Artwork?   @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([artworkId])
  @@index([userId])
  @@index([status])
  @@unique([userId, artworkId])
}

// ===========================================================================
// DOMAIN 13 — COMMISSIONS
// ===========================================================================

enum CommissionStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CommissionRequest {
  id          String           @id @default(uuid())
  buyerId     String
  artistId    String
  title       String
  description String
  budget      Decimal?         @db.Decimal(12, 2)
  currency    String?
  deadline    DateTime?
  status      CommissionStatus @default(SUBMITTED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  buyer        User          @relation("BuyerCommissions", fields: [buyerId], references: [id], onDelete: Restrict)
  artist       ArtistProfile @relation("ArtistCommissions", fields: [artistId], references: [id], onDelete: Restrict)
  conversation Conversation?

  @@index([buyerId])
  @@index([artistId])
  @@index([status])
}

// ===========================================================================
// DOMAIN 14 — NOTIFICATIONS
// ===========================================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([userId, readAt])
}

// ===========================================================================
// DOMAIN 15 — ARTWORK MODERATION
// ===========================================================================

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  RESTORED
}

model ArtworkModeration {
  id        String           @id @default(uuid())
  artworkId String
  adminId   String?
  action    ModerationAction
  reason    String?
  createdAt DateTime         @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  admin   User?   @relation("AdminModerationActions", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([artworkId])
  @@index([adminId])
}

// ===========================================================================
// DOMAIN 16 — AUDIT LOG
// ===========================================================================

enum AuditAction {
  USER_ROLE_UPDATED
  ARTIST_VERIFICATION_CHANGED
  ORDER_STATUS_CHANGED
  ARTWORK_MODERATED
  SYSTEM_SETTING_CHANGED
  REVIEW_APPROVED
  REVIEW_REJECTED
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ===========================================================================
// DOMAIN 17 — MESSAGING
// ===========================================================================

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

model Conversation {
  id                  String             @id @default(uuid())
  commissionRequestId String?            @unique
  buyerId             String
  artistId            String
  status              ConversationStatus @default(OPEN)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  commissionRequest CommissionRequest? @relation(fields: [commissionRequestId], references: [id], onDelete: SetNull)
  buyer             User               @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Restrict)
  artist            ArtistProfile      @relation("ArtistConversations", fields: [artistId], references: [id], onDelete: Restrict)
  messages          Message[]

  @@index([buyerId])
  @@index([artistId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String?
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([createdAt])
}