generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// READ ME FIRST — design decisions a new maintainer should know before
// changing this file. Keep this section updated as decisions change; a
// schema this large is much harder to reason about without it.
// ===========================================================================
//
// 1. IDs: every model uses `id String @id @default(uuid())` — a randomly
//    generated, globally-unique identifier. Consistent across the whole
//    schema; don't introduce auto-increment ints for a new model.
//
// 2. Money: every monetary field is `Decimal @db.Decimal(12, 2)`, never
//    Float. Floats store money as an approximation ("0.1 + 0.2 != 0.3").
//    IMPORTANT for API/frontend authors: Prisma serializes Decimal to
//    JSON as a STRING, not a number — always `Number(value)` before
//    formatting or doing arithmetic in TypeScript.
//
// 3. Currency codes (USD, EUR, XAF, ...) are plain `String`, not an enum —
//    150+ real codes exist and Postgres enums need a migration to add a
//    single new value. Validate the code at the application layer instead.
//
// 4. STRING vs ENUM, the actual rule we follow: use a Postgres enum when
//    the set of values is small, fixed, and changing it SHOULD require a
//    deliberate migration (order status, verification status, review
//    status — these are core business states, and a typo here should be
//    a compile-time error, not a silent bad write). Use a plain String
//    when the set of values is expected to grow over time via normal
//    product/admin activity, not a schema change (Role.name, Category/
//    Medium/Style/Theme.name, Notification.type, Payment.provider).
//    Do NOT add a "shadow enum" next to a String field that's
//    intentionally a String (see the Role note below for a real example
//    of this mistake, already made and reverted once).
//
// 5. Composite primary keys: pure "junction" tables that only ever
//    connect two other records with nothing of their own worth looking
//    up individually (UserRole, RolePermission, ArtworkCategory,
//    ArtworkStyle, ArtworkTheme, ArtworkMedium, Favorite) use a
//    COMPOSITE PRIMARY KEY — e.g. `@@id([userId, roleId])` — instead of a
//    separate synthetic id. That composite key is already guaranteed
//    unique by definition, so it enforces "no duplicate pairs" for free.
//    CartItem is the one exception (it has its own `id`), since cart
//    line items are individually addressable (edit quantity by id, etc).
//
// 6. onDelete follows one consistent rule everywhere: anything that
//    represents FINANCIAL OR HISTORICAL TRUTH (an Order, a Payment, a
//    completed OrderItem's record of what was bought, a Review, an
//    AuditLog entry) is protected with `Restrict` or preserved via
//    `SetNull` — the database refuses to silently destroy that history
//    as a side effect of deleting something else. Anything that's just
//    "glue" with no independent meaning (a CartItem without its Cart, an
//    ArtworkImage without its Artwork) safely cascades. When adding a
//    new relation, ask "does losing this row silently lose something we
//    need to be able to prove happened later?" — if yes, Restrict/
//    SetNull; if no, Cascade is fine.
//
// 7. Indexing philosophy: Postgres does NOT automatically index foreign
//    key columns — every `fields: [xId]` relation should usually have a
//    matching `@@index([xId])` unless it's already covered by a
//    composite index. Beyond foreign keys, index columns that are
//    actually filtered/sorted on in real application queries — check the
//    controller before adding one. Where a hot query path filters or
//    sorts on MULTIPLE columns together (e.g. Artwork's public listing
//    always filters status + visibility and sorts by publishedAt), add
//    ONE composite index covering that combination — it's meaningfully
//    faster than Postgres combining several single-column indexes for
//    the same query, not just a style preference.
//
// ===========================================================================

// ===========================================================================
// DOMAIN 1 — IDENTITY & ACCESS
// ===========================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles                 UserRole[]
  sessions              Session[]
  addresses             Address[]
  artistProfile         ArtistProfile?
  cart                  Cart?
  orders                Order[]
  favorites             Favorite[]
  reviews               Review[]
  commissionsRequested  CommissionRequest[]    @relation("BuyerCommissions")
  notifications         Notification[]
  moderationActions     ArtworkModeration[]    @relation("AdminModerationActions")
  auditLogs             AuditLog[]
  inventoryReservations InventoryReservation[]
  conversationsAsBuyer  Conversation[]         @relation("BuyerConversations")
  messagesSent          Message[]

  @@index([status])
  @@index([createdAt])
}

// Role.name is a String, not an enum — deliberately. Admin capability in
// this system is "a User whose roles include the row named ADMIN" (see
// requireAdmin.ts on the API side), and roles are exactly the kind of
// thing that should be addable by an admin at runtime (e.g. a future
// MODERATOR role) without a code deployment. A `RoleType` enum was added
// here once as a "just in case" safeguard, went unused everywhere, and
// had values (`USER`, not `BUYER`) that didn't even match the roles the
// app actually seeds and checks against — a real, live example of the
// "shadow enum" mistake described in point 4 above. Don't reintroduce it;
// if role values genuinely need to become a fixed, migration-gated set
// later, convert `Role.name` itself to an enum deliberately, not a
// parallel field next to it.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "artwork.create", "order.manage"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Not currently used by the API — auth is stateless, signed JWT cookies
// (see apps/api/src/lib/auth.ts), so nothing writes to this table today.
// It's here, indexed and ready, for whenever the app needs DB-backed
// sessions (server-side revocation, "log out of all devices", a visible
// session list) — a real feature, just not built yet. tokenHash is
// unique so a hash collision (astronomically unlikely, but this is a
// security-relevant table) is a hard constraint violation, not a silent
// duplicate row.
model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // never store a raw, usable session token — only its hash
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  label         String? // e.g. "Home", "Studio"
  recipientName String
  phone         String?
  addressLine1  String
  addressLine2  String?
  city          String
  region        String?
  country       String
  postalCode    String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===========================================================================
// DOMAIN 2 — ARTIST
// ===========================================================================

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model ArtistProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  displayName        String
  slug               String             @unique
  biography          String?
  artisticStatement  String?
  mission            String?
  website            String?
  location           String?
  profileImageUrl    String?
  coverImageUrl      String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements        ArtistAchievement[]
  socialLinks         ArtistSocialLink[]
  // Restrict: deleting an artist's profile must not silently wipe an
  // entire catalog of artworks that may already be tied to real orders.
  // Application code should require artworks to be archived/reassigned
  // first — the database refuses to let that happen by accident.
  artworks            Artwork[]
  orderItems          OrderItem[]
  commissionsReceived CommissionRequest[] @relation("ArtistCommissions")
  conversations       Conversation[]      @relation("ArtistConversations")

  @@index([slug])
  @@index([verificationStatus])
}

model ArtistAchievement {
  id           String   @id @default(uuid())
  artistId     String
  title        String
  organization String?
  description  String?
  year         Int?
  type         String? // free-form on purpose — see point 4 above
  createdAt    DateTime @default(now())

  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

model ArtistSocialLink {
  id        String   @id @default(uuid())
  artistId  String
  platform  String // e.g. "instagram", "twitter"
  url       String
  createdAt DateTime @default(now())

  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, platform])
}

// ===========================================================================
// DOMAIN 3 — ARTWORK
// ===========================================================================

enum ArtworkStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
  SOLD
}

enum ArtworkVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model Artwork {
  id          String            @id @default(uuid())
  artistId    String
  title       String
  slug        String            @unique
  description String?
  artistNotes String?
  price       Decimal           @db.Decimal(12, 2)
  currency    String
  yearCreated Int?
  width       Decimal?          @db.Decimal(8, 2)
  height      Decimal?          @db.Decimal(8, 2)
  depth       Decimal?          @db.Decimal(8, 2)
  weight      Decimal?          @db.Decimal(8, 2)
  materials   String?
  status      ArtworkStatus     @default(DRAFT)
  visibility  ArtworkVisibility @default(PRIVATE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  artist                ArtistProfile          @relation(fields: [artistId], references: [id], onDelete: Restrict)
  images                ArtworkImage[]
  categories            ArtworkCategory[]
  styles                ArtworkStyle[]
  themes                ArtworkTheme[]
  mediums               ArtworkMedium[]
  inventory             Inventory?
  cartItems             CartItem[]
  // SetNull: an OrderItem is a historical SNAPSHOT of a purchase (see
  // OrderItem below) — designed to stay fully meaningful even if the
  // Artwork it pointed at is later deleted. The snapshot fields carry
  // the truth; this live link is a convenience, not a requirement.
  orderItems            OrderItem[]
  favorites             Favorite[]
  reviews               Review[]
  moderationHistory     ArtworkModeration[]
  inventoryReservations InventoryReservation[]

  @@index([artistId])
  @@index([status])
  @@index([visibility])
  @@index([publishedAt])
  @@index([price])
  // The public artwork list/detail endpoints (GET /artworks,
  // GET /artworks/:slug) ALWAYS filter status + visibility together and
  // sort by publishedAt for the default views — this composite index is
  // built specifically for that exact, extremely frequent query shape.
  // The single-column indexes above stay too, for anything that filters
  // on just one of these fields alone.
  @@index([status, visibility, publishedAt])
}

model ArtworkImage {
  id        String   @id @default(uuid())
  artworkId String
  // Deliberately just a URL, not the image itself — Postgres is the
  // wrong tool for binary image data. Points at real object storage/CDN
  // (Cloudinary, S3, etc).
  url       String
  altText   String?
  width     Int?
  height    Int?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@index([artworkId])
  // Matches exactly how the API queries this table: "give me the one
  // primary image for this artwork" (where: { artworkId, isPrimary: true }).
  @@index([artworkId, isPrimary])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  artworks ArtworkCategory[]
}

model Medium {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  artworks ArtworkMedium[]
}

model Style {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  artworks ArtworkStyle[]
}

model Theme {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  artworks ArtworkTheme[]
}

model ArtworkCategory {
  artworkId  String
  categoryId String
  createdAt  DateTime @default(now())

  artwork  Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([artworkId, categoryId])
  @@index([categoryId])
}

model ArtworkStyle {
  artworkId String
  styleId   String
  createdAt DateTime @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  style   Style   @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([artworkId, styleId])
  @@index([styleId])
}

model ArtworkTheme {
  artworkId String
  themeId   String
  createdAt DateTime @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([artworkId, themeId])
  @@index([themeId])
}

model ArtworkMedium {
  artworkId String
  mediumId  String
  createdAt DateTime @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  medium  Medium  @relation(fields: [mediumId], references: [id], onDelete: Cascade)

  @@id([artworkId, mediumId])
  @@index([mediumId])
}

// ===========================================================================
// DOMAIN 4 — INVENTORY
// ===========================================================================

model Inventory {
  id               String   @id @default(uuid())
  artworkId        String   @unique
  quantity         Int      @default(1)
  reservedQuantity Int      @default(0)
  soldQuantity     Int      @default(0)
  // Optimistic locking: every update increments this. If two requests
  // try to update the same inventory row at once, the second can detect
  // its `version` is stale and retry instead of silently overwriting the
  // first — this is what stops two people buying the last copy of a
  // unique artwork at the same instant. "Available" is always COMPUTED
  // as quantity - reservedQuantity - soldQuantity, never stored directly
  // (see artworkControllers.ts's isAvailable()) — that avoids it ever
  // silently drifting out of sync with reality.
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// DOMAIN 5 — CART
// ===========================================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  artworkId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([cartId, artworkId])
  @@index([cartId])
}

// ===========================================================================
// DOMAIN 6 — ORDERS
// ===========================================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  subtotal       Decimal @db.Decimal(12, 2)
  shippingAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  currency       String

  // Stored as JSON snapshots, not foreign keys to Address — if the
  // customer edits/deletes their saved address next week, this order
  // still shows exactly where it actually shipped at the time. A live
  // foreign key couldn't guarantee that.
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict: a user's purchase history is financial record-keeping —
  // the database refuses to let a User be deleted while Orders exist,
  // forcing that to be a deliberate (probably soft-delete/anonymize)
  // application decision, never an accident.
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  payments     Payment[]
  invoice      Invoice?
  shipment     Shipment?
  reservations InventoryReservation[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  // Nullable + SetNull: these are a convenience for "jump to the live
  // artwork/artist page," not the source of truth — the *Snapshot
  // fields below are, and they stay fully meaningful even if the
  // artwork or artist is deleted later.
  artworkId String?
  artistId  String?

  titleSnapshot      String
  artistNameSnapshot String
  unitPrice          Decimal @db.Decimal(12, 2)
  quantity           Int
  currency           String
  subtotal           Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artwork Artwork?       @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  artist  ArtistProfile? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([orderId])
  @@index([artistId])
  @@index([artworkId])
}

// ===========================================================================
// DOMAIN 7 — PAYMENT
// ===========================================================================

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  // e.g. "stripe", "paypal" — plain string, new payment providers are
  // exactly the kind of thing added without a full deployment cycle.
  provider          String
  // The provider's OWN id for this transaction — what you reconcile
  // against if the provider's dashboard and this database ever need to
  // be cross-checked.
  providerPaymentId String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String
  status            PaymentStatus @default(PENDING)
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Restrict: same reasoning as Order.userId above.
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
}

// ===========================================================================
// DOMAIN 8 — INVENTORY RESERVATION
// ===========================================================================

enum ReservationStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONVERTED
}

model InventoryReservation {
  id         String            @id @default(uuid())
  artworkId  String
  userId     String
  orderId    String?
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([artworkId])
  @@index([userId])
  @@index([status])
  // Needed for whatever job/cron sweeps and expires stale reservations —
  // that query is "find everything with expiresAt in the past".
  @@index([expiresAt])
}

// ===========================================================================
// DOMAIN 9 — INVOICE
// ===========================================================================

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  subtotal      Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  currency      String
  issuedAt      DateTime @default(now())
  pdfUrl        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

// ===========================================================================
// DOMAIN 10 — SHIPMENT
// ===========================================================================

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

model Shipment {
  id                  String         @id @default(uuid())
  orderId             String         @unique
  carrier             String?
  trackingNumber      String?
  status              ShipmentStatus @default(PENDING)
  shippedAt           DateTime?
  deliveredAt         DateTime?
  estimatedDeliveryAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status])
}

// ===========================================================================
// DOMAIN 11 — FAVORITES
// ===========================================================================

model Favorite {
  userId    String
  artworkId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@id([userId, artworkId])
  // The composite primary key already makes "this user's favorites"
  // lookups fast. This index specifically supports the OTHER direction —
  // "how many people favorited this artwork" — which the composite key
  // alone doesn't serve efficiently.
  @@index([artworkId])
}

// ===========================================================================
// DOMAIN 12 — REVIEWS
// ===========================================================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id          String       @id @default(uuid())
  userId      String
  artworkId   String?
  // Nullable: orderItemId exists so verified-purchase reviews CAN be
  // enforced later — that enforcement is a deliberate future step, not
  // required today (reviewControllers.ts already best-effort-links this
  // when the reviewer has a delivered order for the artwork, without
  // requiring it).
  orderItemId String?
  rating      Int // constrained to 1-5 at the application layer (Zod) — see the
              // migration note below for the matching DB-level constraint
  title       String?
  comment     String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  artwork   Artwork?   @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([artworkId])
  @@index([userId])
  @@index([status])
  // Enforces "one review per user per artwork" at the database level,
  // not just in reviewControllers.ts's application-layer check —
  // defense in depth, same reasoning as the rating CHECK constraint
  // note below.
  @@unique([userId, artworkId])
}

// IMPORTANT — action required after running `prisma migrate dev`:
// Prisma's schema language has no native "number between X and Y" type,
// so `rating Int` alone does NOT enforce the 1-5 range at the database
// level — only via application-side validation (Zod). To enforce it at
// the database level too (recommended defense-in-depth, in case some
// other future service ever writes to this table directly), open the
// generated migration.sql for this table and add:
//
//   ALTER TABLE "Review" ADD CONSTRAINT "Review_rating_check"
//     CHECK (rating >= 1 AND rating <= 5);
//
// Prisma does not generate this automatically — add it by hand before
// running `prisma migrate deploy`.

// ===========================================================================
// DOMAIN 13 — COMMISSIONS
// ===========================================================================

enum CommissionStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CommissionRequest {
  id          String           @id @default(uuid())
  buyerId     String
  artistId    String
  title       String
  description String
  budget      Decimal?         @db.Decimal(12, 2)
  currency    String?
  deadline    DateTime?
  status      CommissionStatus @default(SUBMITTED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  buyer        User          @relation("BuyerCommissions", fields: [buyerId], references: [id], onDelete: Restrict)
  artist       ArtistProfile @relation("ArtistCommissions", fields: [artistId], references: [id], onDelete: Restrict)
  conversation Conversation?

  @@index([buyerId])
  @@index([artistId])
  @@index([status])
}

// ===========================================================================
// DOMAIN 14 — NOTIFICATIONS
// ===========================================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String // free-form on purpose — see point 4 above
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  // Covers the actual real query: "this user's unread notifications".
  @@index([userId, readAt])
}

// ===========================================================================
// DOMAIN 15 — ARTWORK MODERATION
// ===========================================================================
//
// NOTE for future maintainers: despite the similar name, this table is
// for moderating ARTWORK LISTINGS (an artist submitting a piece for
// approval), NOT review moderation. Approving/rejecting a Review is
// audited via AuditLog instead (see adminReviewController.ts) — don't
// conflate the two when adding new moderation features.

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  RESTORED
}

model ArtworkModeration {
  id        String           @id @default(uuid())
  artworkId String
  adminId   String?
  action    ModerationAction
  reason    String?
  createdAt DateTime         @default(now())

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  // Nullable + SetNull: if an admin account is ever deleted, that must
  // not block old moderation history — just lose the specific link to
  // that now-gone admin account.
  admin   User?   @relation("AdminModerationActions", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([artworkId])
  @@index([adminId])
}

// ===========================================================================
// DOMAIN 16 — AUDIT LOG
// ===========================================================================

// Enum-typed on purpose (unlike Notification.type / Role.name above) —
// this table exists specifically for security/compliance review, so a
// typo'd or inconsistent action name here is a real problem, not a minor
// inconvenience. When a new part of the app needs to write an audit
// entry, add a new value here first rather than passing an arbitrary
// string — see adminReviewController.ts's moderateReview() for the
// pattern (REVIEW_APPROVED / REVIEW_REJECTED were added exactly this way
// when review moderation needed audit coverage).
enum AuditAction {
  USER_ROLE_UPDATED
  ARTIST_VERIFICATION_CHANGED
  ORDER_STATUS_CHANGED
  ARTWORK_MODERATED
  SYSTEM_SETTING_CHANGED
  REVIEW_APPROVED
  REVIEW_REJECTED
}

model AuditLog {
  id         String      @id @default(uuid())
  // Nullable + SetNull: this table's entire purpose is durability for
  // security/compliance review — it must outlive the very user account
  // it's about. Deleting a user must never be able to erase the record
  // that, say, "this account approved a $50,000 refund" three years ago.
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ===========================================================================
// DOMAIN 17 — MESSAGING
// ===========================================================================
//
// Why this exists: without an in-platform way for a buyer and artist to
// discuss a commission's details, people take the conversation to
// WhatsApp/email instead — no record of what was agreed to (a real
// problem the moment there's a dispute), and no platform visibility into
// a negotiation happening because of it.

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

model Conversation {
  id                  String             @id @default(uuid())
  // Nullable on purpose: scoped to commission negotiations for now, but
  // not permanently locked to only that use case — could later support
  // "ask a question about this artwork before buying" too, without a
  // redesign.
  commissionRequestId String?            @unique
  buyerId             String
  artistId            String
  status              ConversationStatus @default(OPEN)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  commissionRequest CommissionRequest? @relation(fields: [commissionRequestId], references: [id], onDelete: SetNull)
  buyer             User               @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Restrict)
  artist            ArtistProfile      @relation("ArtistConversations", fields: [artistId], references: [id], onDelete: Restrict)
  messages          Message[]

  @@index([buyerId])
  @@index([artistId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  // Nullable + SetNull: same reasoning as AuditLog above — the
  // conversation history (what was actually agreed to) should survive
  // even if a sender's account is later deleted.
  senderId       String?
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([createdAt])
}